<resources>
    <!-- Agenda / event view: dark, edge to edge. -->
    <style name="Theme.Cal.Page" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- Settings: the system's dark settings look, with a title bar. -->
    <style name="Theme.Cal.Settings" parent="android:Theme.DeviceDefault">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:colorPrimary">@color/page_bg</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="PageBody">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PageSecondary" parent="PageBody">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PageLabel" parent="PageSecondary">
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="PagePill" parent="PageBody">
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
