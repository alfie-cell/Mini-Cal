<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/event_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:id="@+id/event_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/agenda_dot" />
            <TextView
                android:id="@+id/event_calendar"
                style="@style/PageSecondary"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/event_when"
            style="@style/PageBody"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.2"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/event_repeat"
            style="@style/PageSecondary"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone" />

        <TextView
            android:id="@+id/event_location"
            style="@style/PageBody"
            android:layout_marginTop="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingVertical="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/event_join"
            style="@style/PagePill"
            android:layout_marginTop="16dp"
            android:text="@string/event_join"
            android:visibility="gone" />

        <TextView
            android:id="@+id/event_reminder"
            style="@style/PageSecondary"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.3" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/event_edit_reminders"
                style="@style/PagePill"
                android:text="@string/event_edit_reminders" />
            <TextView
                android:id="@+id/event_sound"
                style="@style/PagePill"
                android:layout_marginStart="8dp"
                android:text="@string/event_sound" />
        </LinearLayout>

        <TextView
            android:id="@+id/event_description_label"
            style="@style/PageLabel"
            android:text="@string/event_details"
            android:visibility="gone" />

        <TextView
            android:id="@+id/event_description"
            style="@style/PageBody"
            android:autoLink="web|email|phone"
            android:lineSpacingMultiplier="1.25"
            android:textColorLink="@color/text_primary"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/event_people_label"
            style="@style/PageLabel"
            android:text="@string/event_people"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/event_people"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/event_open_calendar"
            style="@style/PagePill"
            android:layout_marginTop="32dp"
            android:text="@string/event_open_other_app" />
    </LinearLayout>
</ScrollView>
