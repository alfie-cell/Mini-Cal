<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <Switch
            android:id="@+id/switch_reminders"
            style="@style/SettingsSwitch"
            android:text="@string/pref_reminders" />

        <TextView
            style="@style/SettingsSummary"
            android:paddingHorizontal="24dp"
            android:paddingBottom="8dp"
            android:text="@string/pref_reminders_summary" />

        <LinearLayout
            android:id="@+id/row_add_widget"
            style="@style/SettingsRow">
            <TextView
                style="@style/SettingsTitle"
                android:text="@string/pref_add_widget" />
            <TextView
                style="@style/SettingsSummary"
                android:text="@string/pref_add_widget_summary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_background"
            style="@style/SettingsRow">
            <TextView
                style="@style/SettingsTitle"
                android:text="@string/pref_background" />
            <TextView
                style="@style/SettingsSummary"
                android:text="@string/pref_background_summary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_battery"
            style="@style/SettingsRow">
            <TextView
                style="@style/SettingsTitle"
                android:text="@string/pref_battery" />
            <TextView
                style="@style/SettingsSummary"
                android:text="@string/pref_battery_summary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_system_calendar_notifications"
            style="@style/SettingsRow">
            <TextView
                style="@style/SettingsTitle"
                android:text="@string/pref_system_calendar_notifications" />
            <TextView
                style="@style/SettingsSummary"
                android:text="@string/pref_system_calendar_notifications_summary" />
        </LinearLayout>

        <TextView
            style="@style/SettingsSummary"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:text="@string/pref_calendars_header"
            android:textAllCaps="true" />

        <LinearLayout
            android:id="@+id/calendar_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/calendars_empty"
            style="@style/SettingsSummary"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/pref_calendars_empty"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
